    },Content)
end

local function AddToggle(name, default, callback)
    local Row = Create("Frame", {
        Size = UDim2.new(1,0,0,38),
        BackgroundColor3 = Color3.fromRGB(29,29,29),
        BorderSizePixel = 0
    },Content)

    Corner(Row,6)

    Create("TextLabel", {
        Text = name,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10,0),
        Size = UDim2.new(1,-65,1,0),
        TextXAlignment = Enum.TextXAlignment.Left
    },Row)

    local Switch = Create("TextButton", {
        Text = "",
        Size = UDim2.fromOffset(39,21),
        Position = UDim2.new(1,-49,0.5,-10),
        BackgroundColor3 = default and TKIET.Color
            or Color3.fromRGB(65,65,65),
        BorderSizePixel = 0,
        AutoButtonColor = false
    },Row)

    Corner(Switch,20)

    local Circle = Create("Frame", {
        Size = UDim2.fromOffset(15,15),
        Position = default
            and UDim2.new(1,-18,0.5,-7)
            or UDim2.fromOffset(3,3),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0
    },Switch)

    Corner(Circle,20)

    TKIET.Settings[name] = default

    Switch.Activated:Connect(function()
        local value = not TKIET.Settings[name]
        TKIET.Settings[name] = value

        TweenService:Create(Switch,TweenInfo.new(0.15),{
            BackgroundColor3 = value
                and TKIET.Color
                or Color3.fromRGB(65,65,65)
        }):Play()

        TweenService:Create(Circle,TweenInfo.new(0.15),{
            Position = value
                and UDim2.new(1,-18,0.5,-7)
                or UDim2.fromOffset(3,3)
        }):Play()

        if callback then
            callback(value)
        end
    end)

    return Switch
end

local function AddButton(name, callback)
    local Button = Create("TextButton", {
        Text = name,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Color3.new(1,1,1),
        BackgroundColor3 = Color3.fromRGB(40,40,40),
        Size = UDim2.new(1,0,0,35),
        BorderSizePixel = 0
    },Content)

    Corner(Button,6)

    Button.Activated:Connect(function()
        if callback then callback() end
    end)

    return Button
end

local function AddInput(name, placeholder, callback)
    local Box = Create("Frame", {
        Size = UDim2.new(1,0,0,55),
        BackgroundTransparency = 1
    },Content)

    Create("TextLabel", {
        Text = name,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,20),
        TextXAlignment = Enum.TextXAlignment.Left
    },Box)

    local Input = Create("TextBox", {
        PlaceholderText = placeholder,
        Text = "",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.new(1,1,1),
        PlaceholderColor3 = Color3.fromRGB(130,130,130),
        BackgroundColor3 = Color3.fromRGB(35,35,35),
        Position = UDim2.fromOffset(0,23),
        Size = UDim2.new(1,0,0,30),
        ClearTextOnFocus = false
    },Box)

    Corner(Input,5)

    Input.FocusLost:Connect(function(enterPressed)
        if enterPressed and callback then
            callback(Input.Text)
        end
    end)

    return Input
end

local function AddDropdown(name, options, callback)
    local selected = 1

    local Button = Create("TextButton", {
        Text = name .. ": " .. tostring(options[selected]),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.new(1,1,1),
        BackgroundColor3 = Color3.fromRGB(35,35,35),
        Size = UDim2.new(1,0,0,36),
        BorderSizePixel = 0
    },Content)

    Corner(Button,5)

    Button.Activated:Connect(function()
        selected = selected % #options + 1
        Button.Text = name .. ": " .. tostring(options[selected])
        if callback then
            callback(options[selected])
        end
    end)

    return Button
end

-- Tabs
local Tabs = {
    "Auto Farm",
    "Fishing",
    "Teleport",
    "Config",
    "Misc",
    "Player Utilities"
}

local function ShowTab(tab)
    ClearContent()

    if tab == "Auto Farm" then
        AddTitle("AUTO FARM")

        AddToggle("Auto Cast",false)
        AddToggle("Auto Shake",false)
        AddToggle("Auto Reel",false)
        AddToggle("Instant Bobber",false)

        AddButton("Start Auto Farm",function()
            TKIET:Notify("TKIET","UI configuration only.")
        end)

        AddButton("Stop Auto Farm",function()
            TKIET:Notify("TKIET","Auto Farm configuration stopped.")
        end)

    elseif tab == "Fishing" then
        AddTitle("FISHING")

        AddDropdown("Reel Mode",{
            "Legit",
            "Instant"
        },function(value)
            TKIET.Settings.ReelMode = value
        end)

        AddToggle("Fishing Notifications",true)
        AddToggle("Show Fishing Status",true)
        AddToggle("Show Rod Information",true)

        AddButton("Refresh Information",function()
            local character = Player.Character
            local tool = character and character:FindFirstChildOfClass("Tool")
            TKIET:Notify("Fishing",tool and
                ("Equipped: "..tool.Name) or "No tool equipped.")
        end)

    elseif tab == "Teleport" then
        AddTitle("ISLAND SEARCH")

        AddInput("Search Location","Enter island name...",function(value)
            TKIET.Settings.TeleportSearch = value
            TKIET:Notify("Teleport","Search saved: "..value)
        end)

        AddButton("Refresh Location List",function()
            TKIET:Notify("Teleport","Search configuration refreshed.")
        end)

        AddTitle("AVAILABLE LOCATIONS")

        local locations = {
            "Moosewood",
            "Roslit Bay",
            "Sunstone Island",
            "Terrapin Island",
            "Forsaken Shores",
            "Snowcap Island",
            "Mushgrove Swamp",
            "Statue of Sovereignty",
            "The Arch",
            "Castaway Cliffs",
            "Ancient Isle",
            "Vertigo",
            "Depths"
        }

        for _,location in ipairs(locations) do
            AddButton(location,function()
                TKIET:Notify("Location",location.." selected.")
            end)
        end

    elseif tab == "Config" then
        AddTitle("CONFIGURATION")

        AddDropdown("Reel Mode",{
            "Legit",
            "Instant"
        },function(value)
            TKIET.Settings.ReelMode = value
        end)

        AddToggle("Auto Farm Notifications",true)
        AddToggle("Show Status",true)
        AddToggle("Compact Interface",false)

        AddButton("Reset Configuration",function()
            TKIET.Settings = {}
            TKIET:Notify("Config","Configuration reset.")
        end)

    elseif tab == "Misc" then
        AddTitle("MISCELLANEOUS")

        AddToggle("Anti AFK Setting",false)
        AddToggle("Notifications",true)

        AddButton("Show Notification",function()
            TKIET:Notify("TKIET HUB","Welcome to TKIET Fisch.")
        end)

        AddButton("Unload UI",function()
            TKIET.Unloaded = true
            Gui:Destroy()
        end)

    elseif tab == "Player Utilities" then
        AddTitle("PLAYER UTILITIES")

        AddInput("WalkSpeed","16",function(value)
            local number = tonumber(value)
            if not number or number < 0 or number > 100 then
                TKIET:Notify("Error","Enter a value from 0 to 100.")
                return
            end

            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid.WalkSpeed = number
                TKIET:Notify("Player","WalkSpeed updated.")
            end
        end)

        AddInput("JumpPower","50",function(value)
            local number = tonumber(value)
            if not number or number < 0 or number > 150 then
                TKIET:Notify("Error","Enter a value from 0 to 150.")
                return
            end

            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid.UseJumpPower = true
                humanoid.JumpPower = number
                TKIET:Notify("Player","JumpPower updated.")
            end
        end)

        AddButton("Reset Character",function()
            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid.Health = 0
            end
        end)
    end
end

